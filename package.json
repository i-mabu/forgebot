{
  "dependencies": {
    "discord.js": "^14.25.1"
  },
  "description": "FORGE — Blueprintで作る公開Discord Bot（Phase 1 土台）",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "forge",
